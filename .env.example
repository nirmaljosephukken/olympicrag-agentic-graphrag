# TigerGraph Savanna (or Community Edition) connection
TG_HOST=https://<your-workspace>.i.tgcloud.io
TG_SECRET=<savanna secret>
TG_GRAPH=OlympicRAG
# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=<key>
GEMINI_MODEL=gemini-3.1-flash-lite
JUDGE_MODEL=gemini-3.1-flash-lite
MAX_AGENT_STEPS=8
RAG_K=8
# optional: several keys, rotated when one key's daily free-tier quota is used up
# GEMINI_API_KEYS=key1,key2
# TigerGraph MCP: route every installed query through the official TigerGraph MCP server (RESTPP fallback is automatic)
TG_TRANSPORT=mcp
# only behind an HTTPS proxy (sandboxed networks): TG_MCP_TRUST_ENV=1
